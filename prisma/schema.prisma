generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Project {
  id            String        @id @default(cuid())
  name          String
  clientName    String?
  contractValue Decimal
  startDate     DateTime?
  status        String        @default("ACTIVE")
  costs         CostEntry[]
  payments      Payment[]
  changeOrders  ChangeOrder[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}


model CostEntry {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  category    String
  description String
  amount      Decimal
  vendor      String?
  reference   String?
  createdAt   DateTime     @default(now())
}


model Payment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Decimal
  reference String?
  createdAt DateTime @default(now())
}

model ChangeOrder {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  amount      Decimal
  status      String            @default("PENDING")
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
}

