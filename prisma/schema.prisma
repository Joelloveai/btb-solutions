generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  name            String?
  locale          String         @default("en")
  /// Set for a subcontractor's task-log login; staff users leave it empty.
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
}

model Project {
  id                String             @id @default(cuid())
  name              String
  contractRef       String?
  clientName        String?
  contractValue     Decimal
  startDate         DateTime?
  status            String             @default("ACTIVE")
  sstEnabled        Boolean            @default(false)
  sstRate           Decimal            @default(6.00)
  lastClaimNumber   Int                @default(0)
  retentionPercent  Decimal            @default(5.00)
  retentionReleased Decimal            @default(0)
  costs             CostEntry[]
  payments          Payment[]
  changeOrders      ChangeOrder[]
  boqLines          BoqLine[]
  claims            Claim[]
  quote             Quote?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  Client            Client?            @relation(fields: [clientId], references: [id])
  clientId          String?
  photos            Photo[]
  tasks             Task[]
  punchItems        PunchItem[]
  documents         Document[]
  /// One of PROJECT_STAGES (lib/constants.ts): shown to the client as the current stage of the job.
  stage             String?
  selections        Selection[]
  dailyLogs         DailyLog[]
  paymentMilestones PaymentMilestone[]
  timelineEvents    TimelineEvent[]
  siteDiaries       SiteDiary[]
  evidencePacks     EvidencePack[]
}

model CostEntry {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date            DateTime
  category        String
  description     String
  amount          Decimal
  vendor          String?
  reference       String?
  /// Set on SUBCON costs once the subcontractor has been paid.
  paidAt          DateTime?
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  boqLineId       String?
  boqLine         BoqLine?       @relation(fields: [boqLineId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  /// Set by offline-capable clients. A retried upload with the same id is recognised and not applied twice.
  clientRequestId String?        @unique
}

model Payment {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date            DateTime
  amount          Decimal
  reference       String?
  claimId         String?
  claim           Claim?   @relation(fields: [claimId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  /// Set by offline-capable clients. A retried upload with the same id is recognised and not applied twice.
  clientRequestId String?  @unique
}

model ChangeOrder {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date              DateTime
  description       String
  amount            Decimal
  status            String    @default("PENDING")
  approvedAt        DateTime?
  boqLineId         String?
  boqLine           BoqLine?  @relation(fields: [boqLineId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  /// When staff sent this change order to the client's portal for approval. Clients see only sent ones.
  sentToClientAt    DateTime?
  /// "APPROVED" or "REJECTED", as decided by the client in the portal. The time is the SERVER clock.
  clientDecision    String?
  clientDecidedAt   DateTime?
  clientDecidedById String?
}

/// One line of a project's bill of quantities: Qty x Rate = Amount.
model BoqLine {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position     Int
  description  String
  qty          Decimal
  unit         String
  rate         Decimal
  amount       Decimal
  costs        CostEntry[]
  changeOrders ChangeOrder[]
  createdAt    DateTime      @default(now())
}

/// A formal progress claim. Money fields are snapshots taken when the claim is issued.
model Claim {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number           Int
  date             DateTime
  workDone         Decimal
  sstAmount        Decimal
  amountClaimed    Decimal
  retentionPercent Decimal
  retentionAmount  Decimal
  previousClaimed  Decimal
  netClaim         Decimal
  payments         Payment[]
  createdAt        DateTime  @default(now())

  @@unique([projectId, number])
}

model Subcontractor {
  id         String      @id @default(cuid())
  name       String
  contact    String?
  trade      String?
  bank       String?
  costs      CostEntry[]
  users      User[]
  tasks      Task[]
  punchItems PunchItem[]
  createdAt  DateTime    @default(now())
}

model Quote {
  id         String      @id @default(cuid())
  number     Int         @unique
  clientName String
  title      String
  date       DateTime
  status     String      @default("DRAFT")
  sstEnabled Boolean     @default(false)
  sstRate    Decimal     @default(6.00)
  notes      String?
  projectId  String?     @unique
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lines      QuoteLine[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int
  description String
  qty         Decimal
  unit        String
  unitPrice   Decimal
  amount      Decimal
}

model Client {
  id            String       @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  projects      Project[]
  portalUsers   ClientUser[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/// A client's login to the read-only progress portal. Separate from staff `User`.
model ClientUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

/// An uploaded image. The file lives on disk (UPLOAD_DIR); only metadata is stored here.
/// kind: PROGRESS (shown to the client), FLOORPLAN (shown to the client), TASK (subcontractor update, staff only).
model Photo {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind            String     @default("PROGRESS")
  caption         String?
  mimeType        String
  size            Int
  takenAt         DateTime   @default(now())
  uploadedById    String?
  task            Task?
  punchIssue      PunchItem? @relation("PunchIssuePhoto")
  punchFix        PunchItem? @relation("PunchFixPhoto")
  selection       Selection?
  createdAt       DateTime   @default(now())
  /// Evidence metadata. capturedAt is the DEVICE clock when the photo was taken; createdAt is the server clock when it arrived.
  capturedAt      DateTime?
  latitude        Float?
  longitude       Float?
  /// GPS accuracy in metres, as reported by the phone.
  accuracy        Float?
  /// One of PHOTO_TRADES / PHOTO_PHASES in lib/constants.ts
  trade           String?
  phase           String?
  /// Free text, e.g. "Level 3, Unit 12, Master Bath". Used to compare the same spot on different dates.
  location        String?
  /// Which "before cover" checklist item this photo satisfies (see BEFORE_COVER_ITEMS).
  checklistItem   String?
  /// SHA-256 of the stored file, computed on arrival, so a later evidence package can prove the file is unchanged.
  sha256          String?
  /// Set by offline-capable clients. A retried upload with the same id is recognised and not applied twice.
  clientRequestId String?    @unique
}

/// A job for a subcontractor (or the contractor's own crew when subcontractorId is empty).
/// Tasks with startDate/dueDate are what the client sees on the timeline.
model Task {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  description     String
  startDate       DateTime?
  dueDate         DateTime
  isMilestone     Boolean        @default(false)
  status          String         @default("OPEN")
  photoId         String?        @unique
  photo           Photo?         @relation(fields: [photoId], references: [id], onDelete: SetNull)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  /// Set by offline-capable clients. A retried upload with the same id is recognised and not applied twice.
  clientRequestId String?        @unique
}

/// A defect to be fixed before handover. OPEN -> DONE (the subcontractor says it is fixed) -> CLOSED (the contractor has checked it).
model PunchItem {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Free text, e.g. "Level 3, Unit 12, Master Bath"
  location        String
  description     String
  /// One of PHOTO_TRADES (lib/constants.ts)
  trade           String
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  status          String         @default("OPEN")
  dueDate         DateTime?
  /// The photo of the defect, taken when the item was raised.
  photoId         String?        @unique
  photo           Photo?         @relation("PunchIssuePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  /// The photo of the fix, taken by the subcontractor.
  resolvedPhotoId String?        @unique
  resolvedPhoto   Photo?         @relation("PunchFixPhoto", fields: [resolvedPhotoId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  /// When the subcontractor marked it fixed.
  resolvedAt      DateTime?
  /// When the contractor checked it and closed it.
  closedAt        DateTime?
  clientRequestId String?        @unique
}

/// One uploaded version of a named document (drawing, specification, contract). Uploading the same
/// name again creates the next version; only the latest is `isCurrent`.
model Document {
  id              String   @id
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  /// Lower-cased, trimmed name: what decides that two uploads are versions of the same document.
  nameKey         String
  /// One of DOCUMENT_TYPES (lib/constants.ts)
  type            String
  /// One of PHOTO_TRADES; empty means "relevant to every trade".
  trade           String?
  version         Int
  isCurrent       Boolean  @default(true)
  /// Where the bytes are stored (an R2 key; local-disk storage uses the id).
  fileKey         String
  fileName        String
  mimeType        String
  size            Int
  sha256          String
  /// What changed in this version, e.g. "Rev B: kitchen wall moved 300 mm".
  note            String?
  uploadedById    String?
  uploadedAt      DateTime @default(now())
  clientRequestId String?  @unique

  @@unique([projectId, nameKey, version])
  @@index([projectId, isCurrent])
}

/// A product choice (tiles, paint, fixtures) the client is asked to approve in their portal.
model Selection {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// e.g. Tiles, Paint, Fixtures, Appliances
  category        String
  name            String
  details         String?
  photoId         String?   @unique
  photo           Photo?    @relation(fields: [photoId], references: [id], onDelete: SetNull)
  /// PENDING until the client approves it.
  status          String    @default("PENDING")
  /// Server clock.
  approvedAt      DateTime?
  approvedById    String?
  createdAt       DateTime  @default(now())
  clientRequestId String?   @unique
}

/// A day's note for the client, shown with the photos taken that day.
model DailyLog {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The calendar day the note is about (held at UTC midnight).
  date            DateTime
  note            String
  createdAt       DateTime @default(now())
  clientRequestId String?  @unique

  @@index([projectId, date])
}

/// One instalment of the client's payment schedule, e.g. "Deposit" 10%.
/// Whether it is paid is worked out from the project's recorded payments, never entered twice.
model PaymentMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  label     String
  /// Share of the total the client is billed (contract + approved variations + SST).
  percent   Decimal
  dueDate   DateTime?
  createdAt DateTime  @default(now())
}

/// Append-only record of what happened on a project. Each row's hash covers its content and the previous
/// row's hash, so altering or removing any past row breaks the chain from that point on.
model TimelineEvent {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq             Int
  eventType       String
  actorId         String?
  actorRole       String
  actorName       String?
  title           String
  description     String?
  metadata        String   @default("{}")
  latitude        Float?
  longitude       Float?
  capturedAt      DateTime
  createdAt       DateTime @default(now())
  hash            String
  previousHash    String?
  /// Lets a retried note from a phone with bad signal be recognised. Not part of the hash.
  clientRequestId String?  @unique

  @@unique([projectId, seq])
  @@index([projectId, capturedAt])
}

/// The digital Buku Harian Tapak Bina: one per project per day, signed by the preparer and countersigned.
/// Once countersigned (status LOCKED) it is never changed.
model SiteDiary {
  id                    String    @id
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date                  DateTime
  weather               String
  /// JSON: { "Plumbing": 3, ... }
  manpower              String    @default("{}")
  /// JSON array of names
  machinery             String    @default("[]")
  /// JSON array of { description, vendor } taken from that day's material costs
  materialsIn           String    @default("[]")
  worksDone             String
  issues                String?
  visitorLog            String?
  status                String    @default("AWAITING_COUNTERSIGN")
  preparedById          String
  preparedBy            String
  preparedAt            DateTime
  preparedSignature     String
  preparedSignatureHash String
  verifiedById          String?
  verifiedBy            String?
  verifiedAt            DateTime?
  verifiedSignature     String?
  verifiedSignatureHash String?
  /// SHA-256 of the diary's content (what both signatures are bound to)
  contentHash           String
  pdfKey                String?
  pdfSha256             String?
  clientRequestId       String?   @unique
  createdAt             DateTime  @default(now())

  @@unique([projectId, date])
}

/// A generated CIPAA / evidence PDF, kept so the exact file that was handed over can be produced again.
model EvidencePack {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String
  claimId     String?
  pdfKey      String
  sha256      String
  eventCount  Int
  headHash    String?
  generatedBy String
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}
